# Ejemplo de configuración local
# Reemplaza estos valores en tu entorno local.
# No guardes contraseñas reales ni tokens en Git.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=uajs_smart_campus
MYSQL_USER=TU_USUARIO_MYSQL
MYSQL_PASSWORD=CAMBIAR_LOCALMENTE

JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LOCAL_SEGURO

USUARIOS_PORT=8081
SOLICITUDES_PORT=8082
RESERVAS_PORT=8083
RECURSOS_PORT=8084
NOTIFICACIONES_PORT=8085
EVENTOS_PORT=8086
API_GATEWAY_PORT=8080
FRONTEND_PORT=5173
